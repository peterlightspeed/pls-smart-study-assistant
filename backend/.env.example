# --- App ---
ENVIRONMENT=development
# JSON list of allowed frontend origins
CORS_ORIGINS=["http://localhost:3000","https://your-app.vercel.app"]

# --- Supabase ---
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Only needed for legacy projects that still sign tokens with HS256.
# New projects use asymmetric keys, verified through the JWKS endpoint automatically.
SUPABASE_JWT_SECRET=

# --- Database (Supabase > Connect > Session pooler). Prefix is normalised automatically. ---
DATABASE_URL=postgresql://postgres.YOUR-REF:YOUR-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Server-side only. NEVER expose this key to the frontend. (Supabase > Settings > API > service_role)
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=gallery
